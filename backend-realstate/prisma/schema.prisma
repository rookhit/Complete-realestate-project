generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AuthProvider {
  GOOGLE
}

model User {
  id                  String                 @id @default(cuid())
  email               String                 @unique
  name                String?
  phone               String                 @default("")
  passwordHash        String?
  role                Role                   @default(USER)
  // Set once the user proves they own the email (6-digit code, Google sign-in or a password
  // reset link). Email+password accounts can't log in until it is set.
  emailVerifiedAt     DateTime?
  lastLoginAt         DateTime?
  lastLoginIp         String?
  // Access tokens issued before this moment are rejected by requireFreshAuth/requireAdmin.
  sessionsRevokedAt   DateTime?
  // TOTP 2FA. totpSecret is AES-256-GCM encrypted (lib/auth/totp.ts); it is set by /2fa/setup
  // but only active once totpEnabledAt is set. totpLastUsedStep blocks replaying a code.
  totpSecret          String?
  totpEnabledAt       DateTime?
  totpLastUsedStep    Int?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  oauthAccounts       OAuthAccount[]
  auditLogs           AuditLog[]
  mfaRecoveryCodes    MfaRecoveryCode[]
  emailVerification   EmailVerificationCode?
  reactions           PropertyReaction[]
  comments            PropertyComment[]
  listingSubmissions  ListingSubmission[]
}

// One row per refresh token. A login creates one; every refresh revokes it and creates the next.
// rotatedAt is set only when a token was replaced by /refresh, so presenting it again means it
// was copied (reuse detection). ipAddress/userAgent are the client that received the token.
model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  ipAddress String    @default("unknown")
  userAgent String    @default("unknown")
  expiresAt DateTime
  revokedAt DateTime?
  rotatedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// One row per external identity (e.g. a Google account) linked to a User.
// Only the profile Google returns is stored — never Google's own access/refresh tokens.
model OAuthAccount {
  id                String       @id @default(cuid())
  userId            String
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          AuthProvider
  providerAccountId String
  email             String
  emailVerified     Boolean
  name              String?
  pictureUrl        String?
  lastLoginAt       DateTime     @default(now())
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// Append-only log of security-relevant auth events. userId is null for events with no known
// user (e.g. a login attempt for an unknown email) and is kept (set null) if the user is deleted.
// Never store passwords, tokens or token hashes in metadata.
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  event     String
  ipAddress String?
  userAgent String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

// Fixed-window rate-limit counters, one row per "<action>:<ip>" key. Postgres-backed so no
// Redis is needed; old rows are deleted by the cleanup job.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime
}

// Failed-login counter per (client IP, email). Keyed by "<ip>:<sha256(email)>" so the same
// rules apply to unknown emails (no enumeration) and an attacker's IP can't lock the real
// user out from theirs. See lib/auth/login-lockout.ts.
model LoginLockout {
  key         String    @id
  failedCount Int       @default(0)
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt
}

// One-time 2FA recovery codes, stored as SHA-256 hashes.
model MfaRecoveryCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// The current 6-digit email verification code of a user (at most one: a resend replaces it).
// Stored as a SHA-256 hash; dies after 15 minutes or 5 wrong tries. See lib/auth/email-verification.ts.
// failures counts wrong codes across resends (a resend resets attempts, not failures); too many
// set lockedUntil, during which no code is sent or accepted.
model EmailVerificationCode {
  id          String    @id @default(cuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash    String
  attempts    Int       @default(0)
  failures    Int       @default(0)
  lockedUntil DateTime?
  expiresAt   DateTime
  sentAt      DateTime  @default(now())

  @@index([expiresAt])
}

// ─── Properties ───────────────────────────────────────────────────────────────
// Shapes follow the frontend's data/properties.ts and FRONTEND_CLAUDE.md §0.5/§6/§7.8.
// type, badge, facing, road surface and the area units are plain text, not enums: the admin can
// add values in Admin → Dropdown Options. The API checks them against those lists (SiteSetting
// "options:<key>"). Only listing stays an enum, because the NB ID prefix depends on it.

enum ListingType {
  FOR_SALE
  FOR_RENT
}

enum AmenityGroup {
  MAIN_FEATURES
  ROOMS
  FURNISHED
}

enum CommentStatus {
  PENDING
  PUBLISHED
  REJECTED
}

model Property {
  // Internal id, generated by the database. Used in URLs and relations; never typed by the admin.
  id             Int         @id @default(autoincrement())
  // The NB ID number, chosen by the admin (pre-filled with the next free one). The API returns
  // nbId = (FOR_SALE ? "NBS" : "NBL") + the number padded to 3 digits, e.g. "NBS345" / "NBL007",
  // so switching sale ↔ rent changes the prefix and keeps the number. Sale and rent share one
  // sequence, so NBS345 and NBL345 can never both exist. Taken number → 409 REF_TAKEN.
  // Never reused: a soft-deleted property keeps its number.
  nbNumber       Int         @unique
  title          String
  tagline        String      @default("")
  description    String      @default("")
  listing        ListingType
  // One of the "propertyTypes" option list, e.g. "House/Bungalow".
  type           String
  // One of the "badges" option list, e.g. "Hot". NULL = no badge.
  badge          String?
  // Independent flags: a property can be featured, verified, both or neither.
  featured       Boolean     @default(false)
  verified       Boolean     @default(false)
  // Whole rupees (per month when FOR_RENT). NULL = no price given = shown as "Negotiable".
  price          BigInt?
  // NULL = not applicable (e.g. land), shown as "—" on the site.
  bedrooms       Int?
  bathrooms      Int?
  floors         Int?
  buildYear      Int?
  builtAreaValue Decimal?    @db.Decimal(12, 2)
  // One of the "builtUnits" option list ("sq.ft", "sq.m").
  builtAreaUnit  String?
  // Value in landAreaUnit. NULL when the unit is "R-A-P-D": the value is then landAreaRapd.
  landAreaValue  Decimal?    @db.Decimal(12, 2)
  // One of the "landUnits" option list ("Ropani", "Aana", …, "sq.ft") or "R-A-P-D".
  landAreaUnit   String?
  // Ropani-Aana-Paisa-Dam, always four parts: "4-4-0-1" (aana 0-15, paisa 0-3, dam 0-3).
  landAreaRapd   String?
  // Land area in every unit converted to sq.ft, for sorting and filtering by size.
  landAreaSqft   Int?
  // One of the "facings" option list, e.g. "North-East".
  facing         String?
  // One of the "roadSurfaces" option list, e.g. "Black-topped".
  roadSurface    String?
  roadWidthFt    Int?
  // Image URLs in display order; [0] is the cover. Zero or more. The files live in Cloudflare R2;
  // only their URLs are stored here.
  gallery        String[]
  // At most one video per property, optional. The file lives in Cloudflare R2; only its URL is stored.
  videoUrl       String?
  // Free-text selling points, separate from the canonical amenities.
  highlights     String[]
  // The admin's drag-and-drop floor plan: PlanBox[] = { id, name, area (sq.ft), x, y, w, h },
  // x/y/w/h are percentages (0-100) of the plan. NULL = no plan.
  floorPlan      Json?
  // Shown count; the admin can edit it. Kept in step with PropertyReaction rows by the API.
  reactionCount  Int         @default(0)
  // Soft delete, so the admin's "Undo" can restore the same id and NB ID.
  deletedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  location   PropertyLocation?
  amenities  PropertyAmenity[]
  reactions  PropertyReaction[]
  comments   PropertyComment[]
  messages   Message[]
  // The free listing it was published from, if any.
  submission ListingSubmission?

  @@index([listing, type])
  @@index([featured])
  @@index([price])
  @@index([landAreaSqft])
  @@index([createdAt])
  @@index([deletedAt])
}

// What visitors see on the map, chosen by the admin per property.
enum LocationMode {
  // A ~500 m area around a shifted centre, so the property can't be pinpointed (the default).
  APPROXIMATE
  // A pin on the real point.
  EXACT
}

// One location per property.
// PRIVACY: googleMapsUrl, latitude and longitude are ADMIN-ONLY. Public responses send one point,
// `approx: { lat, lng }`, plus locationMode: approxLatitude/approxLongitude when APPROXIMATE,
// latitude/longitude when EXACT.
model PropertyLocation {
  id              Int          @id @default(autoincrement())
  propertyId      Int          @unique
  property        Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  // One of the 77 districts, exact spelling from the frontend's data/districts.ts (filter key).
  district        String
  // Free-text area line shown under the title, e.g. "Jawlakhel, Lalitpur".
  address         String       @default("")
  // The Google Maps link as the admin pasted it (the frontend calls it mapUrl). Short links
  // (maps.app.goo.gl) are resolved on save by the API to get latitude/longitude.
  googleMapsUrl   String?
  // The real point, taken from googleMapsUrl on save (the frontend calls them lat / lng).
  latitude        Decimal?     @db.Decimal(9, 6)
  longitude       Decimal?     @db.Decimal(9, 6)
  locationMode    LocationMode @default(APPROXIMATE)
  // The shifted centre shown in APPROXIMATE mode: the real point moved in a random direction by
  // 350 × √(0.2 + 0.8·u) m, generated once on save and regenerated only when the real point changes
  // (so reloading can't reveal it). The frontend draws the ~500 m area around it.
  approxLatitude  Decimal?     @db.Decimal(9, 6)
  approxLongitude Decimal?     @db.Decimal(9, 6)
  // Pin position (0-100 %) on the frontend's decorative map grid, derived from latitude/longitude
  // when there are any. Not real coordinates.
  mapX            Int          @default(50)
  mapY            Int          @default(50)

  @@index([district])
}

// The canonical amenity list (AMENITIES in the frontend's icons/amenities.tsx). Seeded by prisma/seed.ts.
// Only the name is stored; the frontend picks the icon.
model Amenity {
  id         Int               @id @default(autoincrement())
  name       String            @unique
  group      AmenityGroup
  position   Int               @default(0)
  properties PropertyAmenity[]
}

model PropertyAmenity {
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenityId  Int
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId])
}

// A signed-in user's heart on a property ("like"). One per user per property. This is the only
// like/favourite: there is no separate favourites list. Signed-in users only.
model PropertyReaction {
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([userId, propertyId])
  @@index([propertyId])
}

// A signed-in user's comment on a property with a 1-5 star rating ("Resident Reviews" on the site).
// Only signed-in users can post (the API requires the token; userId is set from it). userId is
// nullable only so the review survives the account being deleted.
// New comments wait for the admin (PENDING). verified is set by the server, never by the client.
model PropertyComment {
  id              Int           @id @default(autoincrement())
  propertyId      Int
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  userId          String?
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Name and photo shown on the site (the frontend's Review.author / avatar), copied from the
  // account at posting time so they survive it being deleted. Photo = the Google profile picture
  // when there is one; NULL = the frontend shows initials.
  authorName      String
  authorAvatarUrl String?
  rating          Int
  body            String
  verified        Boolean       @default(false)
  status          CommentStatus @default(PENDING)
  // Soft delete, so the admin's "Undo" in Admin → Reviews can restore it.
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([propertyId, status, createdAt])
  @@index([userId])
  @@index([deletedAt])
}

// ─── Journal and team ─────────────────────────────────────────────────────────

model TeamMember {
  id              Int       @id @default(autoincrement())
  name            String
  role            String
  photoUrl        String
  department      String?
  bio             String?
  experienceYears Int?
  specialities    String[]
  languages       String[]
  phone           String?
  // Digits with country code, e.g. "9779800000000".
  whatsapp        String?
  email           String?
  // Display order: the About page shows the first 6.
  position        Int       @default(0)
  articles        Article[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([position])
}

model Article {
  id             Int         @id @default(autoincrement())
  slug           String      @unique
  title          String
  category       String
  // Card summary and the article's standfirst.
  excerpt        String
  // Full text, paragraphs separated by a blank line.
  body           String      @default("")
  coverUrl       String
  // Usually a team member; authorName is kept for display (and for guest authors).
  authorId       Int?
  author         TeamMember? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorName     String
  readingMinutes Int         @default(1)
  // Display order: the first is the featured story on the home page.
  position       Int         @default(0)
  // NULL = draft, not shown publicly.
  publishedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([position])
  @@index([publishedAt])
}

// Testimonials on the home page ("What Our Clients Say"), in display order.
model Testimonial {
  id        Int      @id @default(autoincrement())
  name      String
  role      String   @default("")
  // 1-5 whole stars.
  rating    Int
  text      String
  photoUrl  String   @default("")
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

// Company videos ("Explore in Video"), in display order: the first is the centre card.
// Either a YouTube video (youtubeUrl) or an uploaded file (sources, stored in Cloudflare R2).
model Video {
  id         Int      @id @default(autoincrement())
  title      String
  // As shown, e.g. "1:19".
  duration   String   @default("")
  youtubeUrl String?
  // Optional for YouTube (its own thumbnail is used), required in practice for uploads.
  posterUrl  String?
  // Uploaded file(s): VideoSource[] = { label, src, type? }, highest quality first.
  sources    Json?
  // VideoCaption[] as the frontend's player expects.
  captions   Json?
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([position])
}

// Site-wide settings the admin edits, one row per key (value shape = the frontend type):
//   "stats"             Stat[]              home page statistics band
//   "featuredDistricts" FeaturedDistrict[]  home page district tiles (count is computed, not stored)
//   "contact"           ContactInfo         address, phone, whatsapp, email, hours, social links
//   "services"          Service[]           { id, icon, title, desc }, in display order
//   "options:<key>"     string[]            each Admin → Dropdown Options list (data/options.ts keys)
model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// ─── Admin inbox ──────────────────────────────────────────────────────────────

enum MessageKind {
  ENQUIRY
  CALLBACK
  CONTACT
  EMAIL
}

// Admin → Messages: every website form (enquiry, callback, contact) plus emails to the business
// address. Shapes follow the frontend's data/messages.ts.
model Message {
  id         Int         @id @default(autoincrement())
  kind       MessageKind
  name       String
  email      String?
  phone      String?
  subject    String
  // Line breaks kept.
  body       String
  // Property enquiries: the property asked about. Its NB ID comes from the property.
  propertyId Int?
  property   Property?   @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  read       Boolean     @default(false)
  // Set when the admin opens a reply.
  replied    Boolean     @default(false)
  // Soft delete, so "Undo" can restore it.
  deletedAt  DateTime?
  receivedAt DateTime    @default(now())

  @@index([read, receivedAt])
  @@index([kind, receivedAt])
  @@index([propertyId])
  @@index([deletedAt])
}

enum ListingStatus {
  NEW
  DRAFT
  PUBLISHED
  REJECTED
}

// Admin → Free Listings: what a seller sent through the Free Listing form. The admin reviews it
// in the property editor, then publishes it (creates a Property) or saves it for later (draft).
// The seller's details are private: never copied to the Property or shown on the website.
// Text fields are kept exactly as the seller typed them; the admin's cleaned-up version is draft.
// Only signed-in users can submit: userId is the account that sent it (set from the token).
// Nullable only so the listing survives the account being deleted.
model ListingSubmission {
  id                 Int            @id @default(autoincrement())
  status             ListingStatus  @default(NEW)
  // What it was before Reject, so Restore puts it back exactly where it was.
  statusBeforeReject ListingStatus?
  userId             String?
  user               User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Contact details for this listing: they start from the account and the seller may change them.
  sellerName         String
  sellerPhone        String
  sellerEmail        String?
  title              String
  listing            ListingType
  type               String
  district           String
  // As typed, e.g. "5,00,00,000", "3,500 sq.ft", "8 Ropani" or "4-4-0-1".
  price              String         @default("")
  builtArea          String         @default("")
  landArea           String         @default("")
  buildYear          String         @default("")
  description        String         @default("")
  // Canonical amenity names the seller ticked.
  amenities          String[]
  // Photo URLs (Cloudflare R2), [0] = cover.
  photos             String[]
  // The admin's edited property (the frontend Prop shape), kept by "Save for later".
  draft              Json?
  // Set once published.
  propertyId         Int?           @unique
  property           Property?      @relation(fields: [propertyId], references: [id], onDelete: SetNull)
  receivedAt         DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([status, receivedAt])
  @@index([userId])
}
